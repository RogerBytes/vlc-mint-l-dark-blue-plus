+
+/// Translate a skin tooltip with VLC's own translations, so that a skin
+/// written in English shows its tooltips in the user's language.
+/// "Text", "Text (Key)" and "Text $VAR..." are handled: the text and the key
+/// name are looked up in VLC's catalogue, the rest is kept as is.
+static std::string translateTooltip( const std::string &rText )
+{
+    if( rText.empty() )
+        return rText;
+    size_t cut = rText.find( " (" );
+    size_t var = rText.find( " $" );
+    if( var < cut )
+        cut = var;
+    std::string base = rText.substr( 0, cut );
+    std::string rest = ( cut == std::string::npos ) ? "" : rText.substr( cut );
+    if( rest.size() > 4 && rest.compare( 0, 2, " (" ) == 0 &&
+        rest[rest.size() - 1] == ')' )
+    {
+        // Translate the key name, e.g. " (Space)" (single letters are kept)
+        std::string key = rest.substr( 2, rest.size() - 3 );
+        rest = " (" + std::string( vlc_gettext( key.c_str() ) ) + ")";
+    }
+    return std::string( vlc_gettext( base.c_str() ) ) + rest;
+}
