 void X11Window::moveResize( int left, int top, int width, int height ) const
 {
+    if( m_type == GenericWindow::TopWindow ||
+        m_type == GenericWindow::FscWindow )
+    {
+        // Skin windows are positioned before being mapped (and the fullscreen
+        // controller is unmapped and mapped again each time it hides and
+        // shows): tell the window manager that their position is set by the
+        // program, so that it keeps it instead of placing them itself
+        XSizeHints hints;
