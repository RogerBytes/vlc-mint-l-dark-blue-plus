+        hints.flags = USPosition | PPosition;
+        hints.x = left;
+        hints.y = top;
+        XSetWMNormalHints( XDISPLAY, m_wnd, &hints );
+    }
+
     if( width && height )
         XMoveResizeWindow( XDISPLAY, m_wnd, left, top, width, height );
